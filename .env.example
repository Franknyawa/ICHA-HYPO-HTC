# Base de données PostgreSQL serverless (Neon, Supabase, etc.)
# connection_limit=1 recommandé par Prisma quand DATABASE_URL passe par
# PgBouncer (pooler Supabase) — laisse PgBouncer gérer le vrai pooling
# plutôt que d'ouvrir plusieurs connexions depuis le pool interne de Prisma.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentification
AUTH_SECRET="generate-a-random-secret"

# Cron job d'agrégation (voir vercel.json + app/api/cron/aggregate)
# Génère une valeur aléatoire, identique à celle configurée dans Vercel.
CRON_SECRET="generate-a-random-secret"

# URL publique de l'app
NEXT_PUBLIC_APP_URL="https://app.icha-import.com"

# Stockage objet — LWS (mutualisé, via FTP) par défaut, voir STORAGE_PROVIDER
STORAGE_PROVIDER="lws"

# LWS : identifiants FTP de ton hébergement mutualisé (cPanel > FTP Accounts)
LWS_FTP_HOST="ftp.tondomaine.com"
LWS_FTP_USER=""
LWS_FTP_PASSWORD=""
LWS_FTP_BASE_PATH="/public_html/photos"
LWS_PUBLIC_URL="https://tondomaine.com/photos"

# Alternative R2 (STORAGE_PROVIDER="r2") — laissé configuré au cas où
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="icha-import-photos"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Cartographie (GPS / carte de tracking admin)
MAP_API_KEY=""
